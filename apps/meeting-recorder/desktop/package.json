{
  "name": "meeting-recorder-desktop",
  "version": "0.1.0",
  "description": "Desktop recorder for Meeting Recorder — captures screen + audio and uploads to the web dashboard.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --mac --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ruflo.meeting-recorder",
    "productName": "Meeting Recorder",
    "files": ["main.js", "preload.js", "renderer/**/*"],
    "win": { "target": "nsis", "publisherName": "Ruflo" },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" },
    "linux": { "target": "AppImage", "category": "AudioVideo" },
    "publish": null
  }
}
