# ---- MongoDB ----
# A free Atlas cluster works. Database name is taken from the path or MONGODB_DB.
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="meeting_recorder"

# ---- Cloudflare R2 (S3-compatible) ----
# Create a bucket, then an R2 API token (Account -> R2 -> Manage API Tokens).
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="meeting-recordings"
# Optional: a public bucket / custom domain base URL for playback. If unset,
# playback uses short-lived presigned GET URLs (recommended, keeps the bucket private).
R2_PUBLIC_BASE_URL=""

# ---- Groq (transcription) ----
GROQ_API_KEY="gsk_..."
GROQ_TRANSCRIBE_MODEL="whisper-large-v3"

# ---- Anthropic (chat over transcripts) ----
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"

# ---- App ----
# Public base URL of this web app (used by the desktop recorder + share links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Shared secret the desktop recorder sends in the x-api-key header to authorize uploads.
DESKTOP_API_KEY="change-me-to-a-long-random-string"
