# Server-side fallback key for Anthropic (BYOK pasted in the app takes precedence)
ANTHROPIC_API_KEY=

# OpenRouter (OpenAI-compatible). When set, guided reflection runs through
# OpenRouter free-tier models instead of Anthropic. Any key shaped sk-or-…
# is routed to OpenRouter regardless of which variable carries it.
OPENROUTER_API_KEY=

# Optional: pin one model slug (e.g. z-ai/glm-5.2:free). When unset, an
# ordered free-tier fallback chain from src/lib/openrouter.ts is used.
OPENROUTER_MODEL=
