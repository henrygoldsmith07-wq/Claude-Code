# All AI features degrade to deterministic local behaviour when unset.
# AI_PROVIDER=anthropic|openai-compatible|none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Optional encrypted sync. Omitted = local-only, private by default.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Per-IP AI request ceiling per hour (server-side).
AI_RATE_LIMIT_PER_HOUR=60
