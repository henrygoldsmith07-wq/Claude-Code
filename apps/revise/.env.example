# --- Supabase (optional) -----------------------------------------------------
# Leave unset to run the app fully local-first: every feature keeps working
# against IndexedDB, only cross-device sync is disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI provider (optional) --------------------------------------------------
# The provider abstraction picks the first configured provider in this order:
# anthropic -> openai-compatible -> none. With none, the app falls back to
# deterministic, offline generators so every screen still works.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Any OpenAI-compatible endpoint (OpenRouter free tiers, Groq, local llama.cpp)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
