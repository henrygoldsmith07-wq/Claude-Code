# Copy to .env.local and fill in from your Supabase project (Settings -> API).
# The app runs and explains how to set up when these are missing.
# Auth uses Supabase email/password; the anon key is public by design and
# RLS is the security boundary (see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: used by the Node security integration test to bypass RLS for
# test setup/cleanup. Never expose in NEXT_PUBLIC_* and never ship to browser.
# SUPABASE_SERVICE_ROLE_KEY=
