# Supabase project settings — required. This app's entire point is a board
# shared between two people, so unlike a single-user tool it can't fall back
# to browser-only storage. Run supabase/schema.sql against your project,
# then set these from your project's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
