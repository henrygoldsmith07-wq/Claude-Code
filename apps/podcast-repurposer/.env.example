# Claude API key used to generate blog posts, show notes, social snippets, and chapters.
# Visitors can also paste their own key in the form (stored only in their browser).
ANTHROPIC_API_KEY=

# Optional: enables persisting episodes/outputs to Supabase.
# If unset, generation still works and results stay in the browser's local history.
# To enable: run config/supabase/schema.sql against your Supabase project first.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
