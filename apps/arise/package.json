{
  "name": "arise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "test": "node --test tests/*.test.js",
    "benchmark": "node benchmark/validate.js",
    "benchmark:write": "node benchmark/validate.js --write",
    "lint:content": "node scripts/lint-content.mjs",
    "check": "npm run lint:content && npm test",
    "type-check": "tsc --noEmit",
    "verify": "npm run lint:content && npm run type-check && npm test && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
