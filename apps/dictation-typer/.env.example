# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=gsk_...

# Transcription model (Groq-hosted Whisper). whisper-large-v3-turbo is fastest.
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Optional: force a language (ISO-639-1, e.g. "en"). Blank = auto-detect.
DICTATION_LANGUAGE=
