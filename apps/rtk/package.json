{
  "name": "rtk",
  "version": "0.2.0",
  "description": "Cut tool-call tokens by filtering noisy command output to what an LLM agent actually needs — per-tool parsers, structural compression, and preservation guarantees",
  "license": "MIT",
  "author": "henrygoldsmith07-wq",
  "repository": {
    "type": "git",
    "url": "https://github.com/henrygoldsmith07-wq/Claude-Code.git",
    "directory": "apps/rtk"
  },
  "homepage": "https://github.com/henrygoldsmith07-wq/Claude-Code/tree/main/apps/rtk#readme",
  "keywords": [
    "cli",
    "tokens",
    "llm",
    "vitest",
    "typescript",
    "nextjs",
    "filter",
    "claude-code",
    "codex",
    "agent"
  ],
  "bin": {
    "rtk": "./bin/rtk.js"
  },
  "main": "src/cli.js",
  "files": [
    "bin/",
    "src/",
    "benchmark/"
  ],
  "scripts": {
    "test": "node --test",
    "benchmark": "node benchmark/run.js",
    "benchmark:write": "node benchmark/run.js --write",
    "benchmark:agent": "node benchmark/agent-solve.js",
    "benchmark:retention": "node benchmark/retention.js",
    "prepublishOnly": "npm test && node benchmark/run.js && node benchmark/agent-solve.js",
    "type-check": "tsc --noEmit",
    "verify": "npm run type-check && npm test && node benchmark/run.js && node benchmark/agent-solve.js && npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
