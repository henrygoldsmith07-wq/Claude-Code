{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "version":  1,
    "description":  "The checked-in dependency graph used by scripts/vercel-ignore.mjs. Paths are repository-relative. All app projects migrated to standalone GitHub repos on 2026-08-21 (see apps/registry.json \u0027external\u0027); entries kept as deploy:false for provenance.",
    "globalPaths":  [
                        ".nvmrc",
                        ".node-version",
                        ".npmrc",
                        "vercel.json",
                        "package.json",
                        "package-lock.json",
                        "npm-shrinkwrap.json",
                        "pnpm-workspace.yaml",
                        "pnpm-lock.yaml",
                        "yarn.lock",
                        "bun.lock",
                        "bun.lockb",
                        "turbo.json",
                        "nx.json",
                        "lerna.json",
                        "tsconfig.base.json",
                        "config/**"
                    ],
    "ignoredPaths":  [
                         ".github/**",
                         ".claude/**",
                         "docs/**",
                         "wiki/**",
                         "output/**",
                         "raw/**",
                         "scripts/**",
                         "src/**",
                         "vendor/**",
                         ".claude-flow/**",
                         "CLAUDE.md",
                         "IMPROVEMENT_LOG.md",
                         ".gitignore",
                         ".mcp.json",
                         "LICENSE",
                         "apps/registry.json",
                         "**/README.md",
                         "**/docs/**",
                         "**/tests/**",
                         "**/test/**",
                         "**/e2e/**",
                         "**/benchmark/**",
                         "**/__tests__/**",
                         "**/__snapshots__/**",
                         "**/*.test.*",
                         "**/*.spec.*",
                         "**/*.snap"
                     ],
    "shared":  {
                   "theme":  {
                                 "description":  "Canonical Le Studio theme. All app consumers moved to standalone repos on 2026-08-21; each repo now vendors its own copy. This canonical source remains for provenance.",
                                 "paths":  [
                                               "packages/theme/**"
                                           ],
                                 "consumers":  [

                                               ]
                             },
                   "le-studio-tokens":  {
                                            "description":  "Standalone token package. Current Vercel builds use the vendored theme copies and do not import this package at build time.",
                                            "paths":  [
                                                          "packages/le-studio-tokens/**"
                                                      ],
                                            "consumers":  [

                                                          ]
                                        }
               },
    "projects":  {
                     "root":  {
                                  "rootDirectory":  ".",
                                  "kind":  "retired",
                                  "deploy":  false,
                                  "description":  "Repository root is a guardrail, not a deployable application. Retire any Vercel project still pointed here."
                              },
